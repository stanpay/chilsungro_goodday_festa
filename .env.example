# ─────────────────────────────────────────────────────────────
# 클라이언트 (VITE_ 접두사)
#
# 주의: VITE_ 변수는 빌드 시 정적 번들에 그대로 인라인된다.
#       누구나 소스·네트워크 탭에서 값을 볼 수 있으므로 비밀키를 넣지 말 것.
#       (도메인 화이트리스트로 보호되는 공개 키만 허용)
# ─────────────────────────────────────────────────────────────

# 네이버 지도 SDK clientId — 네이버 클라우드 콘솔 > Maps > Application
# Web 서비스 URL에 배포 도메인과 http://localhost:8080 을 등록해야 한다.
# (VITE_NAVER_CLIENT_ID / VITE_NAVER_MAP_CLIENT_ID / VITE_NAVER_NCP_CLIENT_ID 도 대체 인식)
VITE_NAVER_NCP_KEY_ID=

# 카카오 JavaScript 키 (REST 키 아님 — REST 키는 아래 서버리스 섹션)
VITE_KAKAO_APP_KEY=

# 매장 API. 미설정 시 https://mac.kurl.kr:5001 로 폴백한다.
VITE_STORE_API_BASE_URL=

# Chatwoot 상담 위젯. 미설정 시 https://mac.kurl.kr:3001 로 폴백한다.
VITE_CHATWOOT_BASE_URL=

# 분석 (선택 — 비우면 해당 스크립트를 로드하지 않는다)
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=

# 앱 다운로드 링크 (선택)
VITE_APP_DOWNLOAD_LINK=


# ─────────────────────────────────────────────────────────────
# 서버리스 (/api) — 절대 VITE_ 접두사를 붙이지 말 것
#
# 이 값들은 서버에서만 사용되며 번들에 포함되지 않는다.
# Vercel 대시보드의 Environment Variables에 등록한다.
# ─────────────────────────────────────────────────────────────

# 카카오 REST API 키 — /api/kakao/search 가 사용
# (KAKAO_API_KEY / KAKAO_REST_KEY 도 대체 인식)
KAKAO_REST_API_KEY=

# 네이버 NCP 자격증명 — /api/naver/geocode, /api/naver/reverse-geocode 가 사용
# (NAVER_CLIENT_ID / NAVER_CLIENT_SECRET 도 대체 인식)
NAVER_API_KEY_ID=
NAVER_API_KEY=

# /api 프록시 호출을 허용할 출처. 쉼표로 구분한다.
# 미설정 시 운영 도메인 기본값 + 요청이 도달한 호스트를 허용한다.
# 예: https://stan.ai.kr,https://www.stan.ai.kr
ALLOWED_ORIGINS=

# /api/store-redirect-target 의 SSRF 화이트리스트 기준 호스트.
# 미설정 시 VITE_STORE_API_BASE_URL, 그다음 https://mac.kurl.kr:5001 순으로 폴백한다.
STORE_API_BASE_URL=

# VERCEL_URL, VERCEL_BRANCH_URL, VERCEL_PROJECT_PRODUCTION_URL, VERCEL_ENV 는
# Vercel이 자동 주입하므로 직접 설정하지 않는다.


# ─────────────────────────────────────────────────────────────
# 모바일 래퍼 (mobile/) — Expo
# ─────────────────────────────────────────────────────────────

# WebView가 로드할 웹 URL. app.json 의 extra.webUrl 로도 설정할 수 있다.
# 미설정 시 앱이 "환경 변수 설정 필요" 화면을 띄운다.
# 이 값의 출처가 WebView originWhitelist 기준이 되므로 정확히 입력할 것.
EXPO_PUBLIC_WEB_URL=
